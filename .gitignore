# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin 2.x 的增量编译会话目录（出现在仓库根，不是 build/ 的子目录）
.kotlin/

# 本机配置（含绝对路径）
local.properties

# IDE
.idea/
*.iml
captures/

# 本机工具链下载目录（aapt2 解包、gradle 发行版等）
.tooling/

# AI 协作工具的工作区（本地笔记与缓存，与工程本身无关）
.workbuddy/

# 产物
*.apk
*.aab
*.hprof

# ★ 签名材料绝不入库。
#   一旦签名私钥进了 git 历史，就只能换密钥 + 作废已发布版本，
#   而且历史里的密钥永远删不干净（除非重写历史）。
*.jks
*.keystore
keystore.properties

# 发布包（apk）不放仓库：改走 Gitea Releases 附件（见 README「下载」）。
# 仓库只留源码；二进制历史版本在 tag / release 里，不进 git 对象。
